# Copia questo file in .env e compila i valori.
# .env NON va committato: è già in .gitignore.

# --- Supabase ----------------------------------------------------------------
# Dashboard → Settings → API Keys
#
# Supabase ha sostituito le vecchie chiavi JWT (anon / service_role) con:
#   • Publishable key  → sb_publishable_...  sicura nel bundle dell'app
#   • Secret key       → sb_secret_...       SOLO server, mai nell'app
#
# Le vecchie anon/service_role restano sotto "Legacy anon, service_role API
# keys" e continuano a funzionare, ma per un progetto nuovo si usano le nuove.

EXPO_PUBLIC_SUPABASE_URL=https://iuiskyzvuevquisjhblm.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Gemini ------------------------------------------------------------------
# Usata SOLO lato server (edge function).
# Non anteporre mai EXPO_PUBLIC_ a questa chiave: quel prefisso la include nel
# bundle dell'app, dove chiunque può estrarla.
GEMINI_API_KEY=

# --- Altro -------------------------------------------------------------------
# Versione dell'informativa privacy in vigore, registrata in public.consents
# a ogni consenso raccolto.
EXPO_PUBLIC_POLICY_VERSION=2026-08-22
