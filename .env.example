# Copia questo file in .env e compila i valori.
# .env NON va committato: è già in .gitignore.

# Supabase — Dashboard → Settings → API
# ATTENZIONE: il progetto deve stare in regione UE (Frankfurt / eu-central-1).
# La regione si sceglie alla creazione e non si cambia dopo.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Gemini — usata SOLO lato server (edge function).
# Non anteporre mai EXPO_PUBLIC_ a questa chiave: finirebbe nel bundle
# dell'app e sarebbe estraibile da chiunque.
GEMINI_API_KEY=

# Versione dell'informativa privacy attualmente in vigore.
# Registrata in public.consents a ogni consenso raccolto.
EXPO_PUBLIC_POLICY_VERSION=2026-08-22
